# Gemini API Keys — Landing Page (AI Studio Free Tier, Project Terpisah dari GCP Billing)
GEMINI_API_KEY=test

# DevRAB Integration (M2M)
DEVRAB_API_URL=
DEVRAB_API_KEY=

# Admin Monitoring PIN (untuk TtsQuotaModal: kuota TTS, Search Grounding, & WhatsApp Zannah)
TTS_USAGE_PIN=123456

# ── WhatsApp Business Cloud API (Meta Developer Dashboard) ───────────────────
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# ── Kontak & Notifikasi WhatsApp Zannah AI ──────────────────────────────────
WA_OWNER_PHONE=6282312312734
WA_DISPLAY_NUMBER=+15557499583
WA_NOTIFY_OWNER=true

# ── Pengaman Kuota & Perilaku ───────────────────────────────────────────────
WA_MONTHLY_MESSAGE_LIMIT=950
WA_MONTHLY_BUDGET_IDR=5000
WA_SKIP_SAVED_CONTACTS=true
WA_SMART_DELAY_MS=15000
WA_SAFE_DELIVERY_NOTE=

# ── Upstash Redis & GCP Vertex AI ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GCP_SERVICE_ACCOUNT_JSON=

# ── Google Drive: Penyimpanan Lampiran WhatsApp (akun Gmail KHUSUS, bukan pribadi) ──
# Jalankan `npm run google:auth` satu kali untuk mendapatkan GDRIVE_REFRESH_TOKEN.
# Buat OAuth Client ID tipe "Desktop app" di Google Cloud Console (Drive API aktif).
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Folder dibuat otomatis oleh backend (scope drive.file) jika GDRIVE_FOLDER_ID kosong.
GDRIVE_FOLDER_NAME=WhatsApp-Bot-Media
GDRIVE_FOLDER_ID=
# Email pribadi yang otomatis diberi akses Editor ke folder (agar bisa dibuka dari HP).
GDRIVE_SHARE_EMAIL=jarzha@gmail.com
# Batas ukuran lampiran yang diarsipkan (MB, 1–25). Default 15.
WA_MEDIA_MAX_MB=15
