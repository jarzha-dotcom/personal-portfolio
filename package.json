{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "postbuild": "npm run prerender",
    "prerender": "tsx --import ./scripts/register-asset-stub.mjs scripts/prerender.ts",
    "upload:images": "tsx --env-file=.env.local scripts/upload-images.ts",
    "audio": "tsx --env-file=.env.local scripts/generate-article-audio.ts",
    "audio:upload": "tsx --env-file=.env.local scripts/generate-article-audio.ts --upload=blob",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo:watermark": "node scripts/inject-demo-watermark.js",
    "demo:thumbs": "npx tsx scripts/generate-demo-thumbs.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/tar-stream": "^3.1.4",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "tar-stream": "^3.2.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/node": "^12.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "music-metadata": "^12.0.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}