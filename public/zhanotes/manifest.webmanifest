{
  "name": "ZhaNotes — Catatan & Kanvas",
  "short_name": "ZhaNotes",
  "description": "Catatan halaman, kanvas tak terbatas, PDF, dan backlink. Data tersimpan di perangkat.",
  "id": "/zhanotes/",
  "start_url": "/zhanotes/",
  "scope": "/zhanotes/",
  "display": "standalone",
  "background_color": "#faf9f7",
  "theme_color": "#faf9f7",
  "lang": "id",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/zhanotes/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/zhanotes/icons/icon-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/zhanotes/icons/icon-maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Catatan baru", "short_name": "Baru", "url": "/zhanotes/?aksi=baru", "icons": [{ "src": "/zhanotes/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Tangkap cepat", "short_name": "Tangkap", "url": "/zhanotes/?aksi=tangkap", "icons": [{ "src": "/zhanotes/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Cari", "short_name": "Cari", "url": "/zhanotes/?aksi=cari", "icons": [{ "src": "/zhanotes/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/zhanotes/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "judul", "text": "teks", "url": "url" }
  },
  "file_handlers": [
    {
      "action": "/zhanotes/",
      "accept": { "application/zip": [".zhn"] },
      "icons": [{ "src": "/zhanotes/icons/zhn-256.png?v=1", "sizes": "256x256", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "screenshots": [
    { "src": "/zhanotes/screenshots/desktop.png?v=1", "sizes": "1600x764", "type": "image/png", "form_factor": "wide", "label": "Catatan halaman dengan tab Berkas, toolbar, dan daftar isi" },
    { "src": "/zhanotes/screenshots/mobile.png?v=1", "sizes": "485x706", "type": "image/png", "form_factor": "narrow", "label": "Beranda ZhaNotes di HP" }
  ]
}
