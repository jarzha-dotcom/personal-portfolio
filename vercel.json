{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/zhanotes/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' blob: data: https://*.blob.vercel-storage.com https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://*.wikipedia.org https://api.crossref.org; img-src 'self' data: blob: https:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/tts.ts": {
      "maxDuration": 30
    },
    "api/zhanotes-cloud.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/demos",
      "destination": "/demos/",
      "permanent": false
    },
    {
      "source": "/zhanotes",
      "destination": "/zhanotes/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hasil-kerja",
      "destination": "/hasil-kerja/index.html"
    },
    {
      "source": "/layanan",
      "destination": "/layanan/index.html"
    },
    {
      "source": "/tentang",
      "destination": "/tentang/index.html"
    },
    {
      "source": "/kontak",
      "destination": "/kontak/index.html"
    },
    {
      "source": "/artikel",
      "has": [{ "type": "query", "key": "page", "value": "2" }],
      "destination": "/artikel/page/2/index.html"
    },
    {
      "source": "/artikel",
      "destination": "/artikel/index.html"
    },
    {
      "source": "/artikel/apa-itu-audit-trail-dan-kenapa-bisnismu-butuh",
      "destination": "/artikel/apa-itu-audit-trail-dan-kenapa-bisnismu-butuh/index.html"
    },
    {
      "source": "/artikel/checklist-sebelum-konsultasi-pertama-dengan-developer",
      "destination": "/artikel/checklist-sebelum-konsultasi-pertama-dengan-developer/index.html"
    },
    {
